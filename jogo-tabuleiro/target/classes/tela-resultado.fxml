<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="600.0" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lustozas.controllers.TelaResultadoController">
   <children>
      <VBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="500.0" prefWidth="600.0" spacing="16">
         <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>
         <children>
            <Text styleClass="titulo" text="Partida Encerrada">
               <font><Font size="30.0" /></font>
            </Text>
            <Label fx:id="labelVencedor" styleClass="label-destaque" text="...">
               <font><Font size="22.0" /></font>
            </Label>
            <Label styleClass="subtitulo" text="Resultado final:">
               <font><Font size="18.0" /></font>
            </Label>
            <ScrollPane fitToWidth="true" prefHeight="220" styleClass="painel">
               <content>
                  <VBox fx:id="containerResultados" spacing="8">
                     <padding><Insets top="8" right="8" bottom="8" left="8" /></padding>
                  </VBox>
               </content>
            </ScrollPane>
            <Button fx:id="botaoVoltar" onAction="#aoClicarVoltar" styleClass="button-principal" text="Voltar ao início" minWidth="200" prefWidth="200" maxWidth="200">
               <font><Font size="16.0" /></font>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>